#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ROOT_DIR="${INTEROP_ROOT:-${SCRIPT_ROOT}}"
PEERS_DIR="${INTEROP_PEERS_DIR:-${ROOT_DIR}/interop/peers}"
APPROVALS_DIR="${INTEROP_APPROVALS_DIR:-${ROOT_DIR}/interop/approvals}"
DEFAULT_RUNTIME="${CONTAINER_RUNTIME:-}"

usage() {
  cat <<'EOF'
Usage:
  interop-peer help
  interop-peer validate-manifests
  interop-peer validate-gates [--require-cache] [peer]
  interop-peer build-image [--dry-run] <peer>
  interop-peer prepare-cache [--dry-run] [peer]
  interop-peer launch [--dry-run] <peer> <client|server|naming> [scenario]
  interop-peer health [--dry-run] <peer>
  interop-peer report [--dry-run] <peer>
  interop-peer run-scenario [--dry-run] [--require-live] <scenario> <peer|all>
  interop-peer run-direction-matrix [--dry-run] [--require-live] <scenario> <peer|all>
  interop-peer local-lane-report [--dry-run] <scenario> <jvm|native> <client|server> [peer] [direction]
  interop-peer native-lane-report [--dry-run] <scenario> <client|server>

G6-830/G7-090 run approved peer containers when external artifacts and images
are present. Dry-run commands do not download peer artifacts, build images,
start ORBs, or run interop assertions.
EOF
}

fail() {
  echo "interop-peer: $*" >&2
  exit 1
}

manifest_path() {
  local peer="$1"
  local path="${PEERS_DIR}/${peer}/peer.yaml"
  if [[ ! -f "${path}" ]]; then
    fail "unknown peer '${peer}'"
  fi
  printf '%s\n' "${path}"
}

manifest_value() {
  local manifest="$1"
  local dotted_path="$2"
  python3 - "$manifest" "$dotted_path" <<'PY'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as handle:
    data = yaml.safe_load(handle)

value = data
for segment in sys.argv[2].split("."):
    value = value[segment]
print(value)
PY
}

validate_manifests() {
  python3 - "${PEERS_DIR}" <<'PY'
import glob
import os
import sys
import yaml

required_top_level = {
    "name",
    "displayName",
    "status",
    "gate",
    "peerType",
    "requirementIds",
  "roles",
  "scenarioGroups",
    "scenarioCapabilities",
  "candidateOrigin",
    "license",
    "approval",
    "cleanRoom",
    "container",
    "launch",
    "reports",
}

required_container = {
    "imageName",
    "buildStatus",
    "baseImagePolicy",
    "artifactInputs",
    "artifactCache",
    "vendoredPeerArtifacts",
    "ports",
    "buildFile",
    "buildScript",
}

required_launch = {
    "clientCommand",
    "serverCommand",
    "namingCommand",
    "readinessCheck",
}

required_container_commands = {
    "client",
    "server",
    "naming",
    "health",
    "report",
}

known_directions = {"peer-server-to-local-client", "local-server-to-peer-client"}
known_local_runtimes = {"jvm", "native"}
known_classifications = {
    "expected-deferral",
    "object-reference-checked",
    "server-ready",
    "calculator-checked",
    "infrastructure-failure",
    "unsupported-scenario",
    "missing-prerequisite",
    "our-bug",
    "peer-bug",
    "spec-ambiguity",
    "profile-mismatch",
}

failed = False
for path in sorted(glob.glob(os.path.join(sys.argv[1], "*", "peer.yaml"))):
    with open(path, encoding="utf-8") as handle:
        manifest = yaml.safe_load(handle)

    missing = sorted(required_top_level - set(manifest))
    missing_container = sorted(required_container - set(manifest.get("container", {})))
    missing_launch = sorted(required_launch - set(manifest.get("launch", {})))
    missing_container_commands = sorted(required_container_commands - set(manifest.get("containerCommands", {})))
    if missing or missing_container or missing_launch or missing_container_commands:
        failed = True
        print(f"{path}: invalid manifest", file=sys.stderr)
        if missing:
            print(f"  missing top-level fields: {', '.join(missing)}", file=sys.stderr)
        if missing_container:
            print(f"  missing container fields: {', '.join(missing_container)}", file=sys.stderr)
        if missing_launch:
            print(f"  missing launch fields: {', '.join(missing_launch)}", file=sys.stderr)
        if missing_container_commands:
            print(f"  missing container command fields: {', '.join(missing_container_commands)}", file=sys.stderr)
        continue

    if manifest["container"]["vendoredPeerArtifacts"] is not False:
        failed = True
        print(f"{path}: vendoredPeerArtifacts must be false", file=sys.stderr)
        continue
    if not manifest.get("scenarioGroups"):
        failed = True
        print(f"{path}: scenarioGroups must not be empty", file=sys.stderr)
        continue

    scenario_groups = set(manifest.get("scenarioGroups", []))
    capabilities = manifest.get("scenarioCapabilities", {})
    if not isinstance(capabilities, dict) or not capabilities:
        failed = True
        print(f"{path}: scenarioCapabilities must not be empty", file=sys.stderr)
        continue
    missing_capabilities = sorted(scenario_groups - set(capabilities))
    if missing_capabilities:
        failed = True
        print(
            f"{path}: scenarioCapabilities must describe every scenarioGroup: {', '.join(missing_capabilities)}",
            file=sys.stderr,
        )
    for scenario, metadata in sorted(capabilities.items()):
        if scenario not in scenario_groups:
            failed = True
            print(
                f"{path}: scenarioCapabilities.{scenario} must also appear in scenarioGroups",
                file=sys.stderr,
            )
            continue
        idl = metadata.get("idl")
        if not idl or os.path.isabs(idl) or ".." in idl.split("/"):
            failed = True
            print(f"{path}: scenarioCapabilities.{scenario}.idl must be a contained relative path", file=sys.stderr)
        if not metadata.get("support"):
            failed = True
            print(f"{path}: scenarioCapabilities.{scenario}.support is required", file=sys.stderr)
        directions = set(metadata.get("directions", []))
        if not directions or not directions <= known_directions:
            failed = True
            print(
                f"{path}: scenarioCapabilities.{scenario}.directions must use known direction names",
                file=sys.stderr,
            )
        local_runtimes = set(metadata.get("localRuntimes", []))
        if not local_runtimes or not local_runtimes <= known_local_runtimes:
            failed = True
            print(
                f"{path}: scenarioCapabilities.{scenario}.localRuntimes must use jvm/native",
                file=sys.stderr,
            )
        classifications = set(metadata.get("expectedClassifications", []))
        if not classifications or not classifications <= known_classifications:
            failed = True
            print(
                f"{path}: scenarioCapabilities.{scenario}.expectedClassifications must use known report classifications",
                file=sys.stderr,
            )

    print(path)

if failed:
    sys.exit(1)
PY
}

validate_gates() {
  local require_cache="false"
  if [[ "${1:-}" == "--require-cache" ]]; then
    require_cache="true"
    shift
  fi
  local requested_peer="${1:-}"
  if [[ $# -gt 1 ]]; then
    fail "validate-gates accepts only --require-cache and an optional peer"
  fi

  python3 - "${ROOT_DIR}" "${PEERS_DIR}" "${APPROVALS_DIR}" "${INTEROP_ARTIFACT_CACHE:-}" "${require_cache}" "${requested_peer}" <<'PY'
import glob
import hashlib
import os
import re
import sys
import yaml

root_dir = os.path.abspath(sys.argv[1])
peers_dir = os.path.abspath(sys.argv[2])
approvals_dir = os.path.abspath(sys.argv[3])
artifact_cache = sys.argv[4]
require_cache = sys.argv[5] == "true"
requested_peer = sys.argv[6]

approved_status = "approved-for-black-box-interop"
hex_sha256 = re.compile(r"^[0-9a-f]{64}$")
failed = False


def error(path, message):
    global failed
    failed = True
    print(f"{path}: {message}", file=sys.stderr)


def load_yaml(path):
    with open(path, encoding="utf-8") as handle:
        return yaml.safe_load(handle)


def relative_path(value):
    return value and not os.path.isabs(value) and ".." not in value.split("/")


def require_false(path, value, field_name):
    if value is not False:
        error(path, f"{field_name} must be false")


def require_contains(path, values, expected, field_name):
    if expected not in values:
        error(path, f"{field_name} must include {expected}")


def validate_cache_entry(approval_path, entry, cache_root):
    entry_path = entry.get("path")
    sha256 = entry.get("sha256")
    if not relative_path(entry_path):
        error(approval_path, f"cache entry path must be relative and contained: {entry_path}")
        return
    if not sha256 or not hex_sha256.fullmatch(sha256):
        error(approval_path, f"cache entry {entry_path} must declare a lowercase SHA-256")
        return
    if not entry.get("sourceUrl"):
        error(approval_path, f"cache entry {entry_path} must declare sourceUrl")
    if require_cache:
        candidate = os.path.join(cache_root, entry_path)
        if not os.path.isfile(candidate):
            error(approval_path, f"cache entry is missing: {candidate}")
            return
        digest = hashlib.sha256()
        with open(candidate, "rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
        actual = digest.hexdigest()
        if actual != sha256:
            error(approval_path, f"cache entry checksum mismatch for {candidate}: expected {sha256}, got {actual}")


if require_cache:
    if not artifact_cache:
        error("INTEROP_ARTIFACT_CACHE", "must be set when --require-cache is used")
    elif not os.path.isabs(artifact_cache):
        error("INTEROP_ARTIFACT_CACHE", "must be an absolute path")
    elif not os.path.isdir(artifact_cache):
        error("INTEROP_ARTIFACT_CACHE", f"does not exist: {artifact_cache}")

cache_root = os.path.abspath(artifact_cache) if artifact_cache else ""
manifest_paths = sorted(glob.glob(os.path.join(peers_dir, "*", "peer.yaml")))
if requested_peer:
    manifest_paths = [os.path.join(peers_dir, requested_peer, "peer.yaml")]
    if not os.path.isfile(manifest_paths[0]):
        error(requested_peer, "unknown peer")

for manifest_path in manifest_paths:
    if failed and requested_peer and not os.path.isfile(manifest_path):
        continue
    manifest = load_yaml(manifest_path)
    peer = manifest.get("name")
    approval_ref = manifest.get("approval")
    if not peer:
        error(manifest_path, "name is required")
        continue
    if manifest.get("status") != "g6-artifact-gate-approved":
        error(manifest_path, f"{peer} status must be g6-artifact-gate-approved")
    if manifest.get("gate") != "G6-820":
        error(manifest_path, f"{peer} gate must be G6-820")
    if not relative_path(approval_ref):
        error(manifest_path, f"{peer} approval path must be relative and contained")
        continue

    approval_path = os.path.abspath(os.path.join(root_dir, approval_ref))
    if not approval_path.startswith(os.path.abspath(approvals_dir) + os.sep):
        error(manifest_path, f"{peer} approval path must stay under {approvals_dir}")
        continue
    if not os.path.isfile(approval_path):
        error(manifest_path, f"{peer} approval file is missing: {approval_path}")
        continue

    approval = load_yaml(approval_path)
    if approval.get("peer") != peer:
        error(approval_path, f"approval peer must be {peer}")
    if approval.get("taskId") != "G6-820-REAL-PEER-ARTIFACT-GATES":
        error(approval_path, "taskId must be G6-820-REAL-PEER-ARTIFACT-GATES")
    if approval.get("approvalStatus") != approved_status:
        error(approval_path, f"approvalStatus must be {approved_status}")
    evidence = approval.get("approvalEvidence", {})
    if not approval.get("reviewer") or not approval.get("reviewDate"):
        error(approval_path, "reviewer and reviewDate are required")
    if not evidence.get("decisionRecord") or not evidence.get("scope"):
        error(approval_path, "approvalEvidence.decisionRecord and approvalEvidence.scope are required")

    manifest_license = manifest.get("license", {})
    approval_license = approval.get("license", {})
    if manifest_license.get("approvalStatus") != approved_status:
        error(manifest_path, f"{peer} license approvalStatus must be {approved_status}")
    if approval_license.get("approvalStatus") != approved_status:
        error(approval_path, f"license approvalStatus must be {approved_status}")
    if approval_license.get("redistributionAllowed") is not False:
        error(approval_path, "license redistributionAllowed must be false")
    if approval_license.get("containerPublicationAllowed") is not False:
        error(approval_path, "license containerPublicationAllowed must be false")

    clean_room = manifest.get("cleanRoom", {})
    approval_clean_room = approval.get("cleanRoom", {})
    for source, source_path in ((clean_room, manifest_path), (approval_clean_room, approval_path)):
        require_false(source_path, source.get("sourceCopyingAllowed"), "cleanRoom.sourceCopyingAllowed")
        require_false(source_path, source.get("sourceVendoringAllowed"), "cleanRoom.sourceVendoringAllowed")
        require_false(source_path, source.get("binaryVendoringAllowed"), "cleanRoom.binaryVendoringAllowed")
        require_contains(source_path, source.get("allowedUses", []), "black-box-interop", "cleanRoom.allowedUses")
        require_contains(source_path, source.get("prohibitedUses", []), "source-copying", "cleanRoom.prohibitedUses")

    container = manifest.get("container", {})
    if container.get("artifactCache") != "external-only":
        error(manifest_path, f"{peer} container.artifactCache must be external-only")
    if container.get("baseImagePolicy") != "digest-pinned-required":
        error(manifest_path, f"{peer} container.baseImagePolicy must be digest-pinned-required")
    require_false(manifest_path, container.get("vendoredPeerArtifacts"), "container.vendoredPeerArtifacts")

    artifact = approval.get("artifact", {})
    origin = manifest.get("candidateOrigin", {})
    if artifact.get("coordinate") != origin.get("coordinate"):
        error(approval_path, "artifact coordinate must match candidateOrigin.coordinate")
    if artifact.get("version") != origin.get("version"):
        error(approval_path, "artifact version must match candidateOrigin.version")

    cache = approval.get("cache", {})
    if cache.get("layout") != "external-only":
        error(approval_path, "cache.layout must be external-only")
    if cache.get("baseImagePolicy") != "digest-pinned-required":
        error(approval_path, "cache.baseImagePolicy must be digest-pinned-required")
    entries = cache.get("entries")
    if not entries:
        error(approval_path, "cache.entries must not be empty")
    else:
        for entry in entries:
            validate_cache_entry(approval_path, entry, cache_root)

    execution = approval.get("realPeerExecution", {})
    if execution.get("status") != "blocked-until-g6-830":
        error(approval_path, "realPeerExecution.status must be blocked-until-g6-830")

    print(f"{peer}: {approval_ref}")

if failed:
    sys.exit(1)
PY
}

resolve_runtime() {
  if [[ -n "${DEFAULT_RUNTIME}" ]]; then
    printf '%s\n' "${DEFAULT_RUNTIME}"
    return
  fi
  if command -v docker >/dev/null 2>&1; then
    printf 'docker\n'
    return
  fi
  if command -v podman >/dev/null 2>&1; then
    printf 'podman\n'
    return
  fi
  fail "CONTAINER_RUNTIME is unset and neither docker nor podman was found"
}

require_digest_pinned_base_image() {
  local peer_type="$1"
  local env_name
  env_name="$(base_image_env_name "${peer_type}")"
  local value="${!env_name:-}"
  if [[ -z "${value}" || "${value}" != *@sha256:* ]]; then
    fail "${env_name} must be set to a digest-pinned image before a real build"
  fi
  printf '%s\n' "${value}"
}

base_image_env_name() {
  local peer_type="$1"
  if [[ "${peer_type}" == "native" ]]; then
    printf 'INTEROP_NATIVE_BASE_IMAGE\n'
  else
    printf 'INTEROP_JAVA_BASE_IMAGE\n'
  fi
}

require_external_artifact_cache() {
  local cache="${INTEROP_ARTIFACT_CACHE:-}"
  if [[ -z "${cache}" ]]; then
    fail "INTEROP_ARTIFACT_CACHE must be set before a real peer image build"
  fi
  if [[ ! -d "${cache}" ]]; then
    fail "INTEROP_ARTIFACT_CACHE does not exist: ${cache}"
  fi
}

resolve_cache_path() {
  local peer="$1"
  local cache="${INTEROP_ARTIFACT_CACHE:-}"
  python3 - "${ROOT_DIR}" "${PEERS_DIR}" "${APPROVALS_DIR}" "${cache}" "${peer}" <<'PY'
import os
import sys
import yaml

root_dir, peers_dir, approvals_dir, cache_root, peer = sys.argv[1:]
manifest_path = os.path.join(peers_dir, peer, "peer.yaml")
with open(manifest_path, encoding="utf-8") as handle:
    manifest = yaml.safe_load(handle)
approval_path = os.path.join(root_dir, manifest["approval"])
approval_path = os.path.abspath(approval_path)
if not approval_path.startswith(os.path.abspath(approvals_dir) + os.sep):
    raise SystemExit(f"approval path must stay under {approvals_dir}")
with open(approval_path, encoding="utf-8") as handle:
    approval = yaml.safe_load(handle)
entries = approval.get("cache", {}).get("entries", [])
if not entries:
    raise SystemExit("cache.entries must not be empty")
for entry in entries:
    print(os.path.join(cache_root, entry["path"]))
PY
}

stage_artifact_cache_for_build() {
  local peer="$1"
  local stage_abs="${ROOT_DIR}/build/interop/container-build/artifact-cache"
  rm -rf "${stage_abs}"
  mkdir -p "${stage_abs}"
  python3 - "${ROOT_DIR}" "${PEERS_DIR}" "${APPROVALS_DIR}" "${INTEROP_ARTIFACT_CACHE:-}" "${peer}" <<'PY' \
    | while IFS=$'\t' read -r rel abs; do
import os
import sys
import yaml

root_dir, peers_dir, approvals_dir, cache_root, peer = sys.argv[1:]
manifest_path = os.path.join(peers_dir, peer, "peer.yaml")
with open(manifest_path, encoding="utf-8") as handle:
    manifest = yaml.safe_load(handle)
approval_path = os.path.abspath(os.path.join(root_dir, manifest["approval"]))
if not approval_path.startswith(os.path.abspath(approvals_dir) + os.sep):
    raise SystemExit(f"approval path must stay under {approvals_dir}")
with open(approval_path, encoding="utf-8") as handle:
    approval = yaml.safe_load(handle)
for entry in approval.get("cache", {}).get("entries", []):
    rel = entry["path"]
    if os.path.isabs(rel) or ".." in rel.split("/"):
        raise SystemExit(f"cache entry path must be relative and contained: {rel}")
    print(f"{rel}\t{os.path.join(cache_root, rel)}")
PY
    mkdir -p "${stage_abs}/$(dirname "${rel}")"
    cp "${abs}" "${stage_abs}/${rel}"
  done
}

scenario_idl() {
  local scenario="$1"
  case "${scenario}" in
    basic-idl) printf 'interop/idl/basic/BasicTypes.idl\n' ;;
    hello) printf 'interop/idl/hello/hello.idl\n' ;;
    rmi-iiop) printf 'interop/idl/rmi-iiop/Calculator.idl\n' ;;
    g12-wide-core-types) printf 'interop/idl/g12-wide/CoreTypes.idl\n' ;;
    g12-wide-repository-pragmas) printf 'interop/idl/g12-wide/RepositoryPragmas.idl\n' ;;
    g12-wide-valuetypes) printf 'interop/idl/g12-wide/ValueTypes.idl\n' ;;
    g12-wide-unsupported-custom-value) printf 'interop/idl/g12-wide/UnsupportedCustomValue.idl\n' ;;
    *) printf 'interop/idl/%s.idl\n' "${scenario}" ;;
  esac
}

scenario_supported() {
  local manifest="$1"
  local scenario="$2"
  python3 - "$manifest" "$scenario" <<'PY'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as handle:
    manifest = yaml.safe_load(handle)

if sys.argv[2] in manifest.get("scenarioCapabilities", {}):
    sys.exit(0)

print(f"{manifest.get('name', sys.argv[1])}: scenario is not declared: {sys.argv[2]}", file=sys.stderr)
sys.exit(1)
PY
}

scenario_supported_quiet() {
  local manifest="$1"
  local scenario="$2"
  python3 - "$manifest" "$scenario" <<'PY'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as handle:
    manifest = yaml.safe_load(handle)

sys.exit(0 if sys.argv[2] in manifest.get("scenarioCapabilities", {}) else 1)
PY
}

scenario_capability_contains() {
  local manifest="$1"
  local scenario="$2"
  local field="$3"
  local value="$4"
  python3 - "$manifest" "$scenario" "$field" "$value" <<'PY'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as handle:
    manifest = yaml.safe_load(handle)

metadata = manifest.get("scenarioCapabilities", {}).get(sys.argv[2], {})
sys.exit(0 if sys.argv[4] in metadata.get(sys.argv[3], []) else 1)
PY
}

scenario_capability_values() {
  local manifest="$1"
  local scenario="$2"
  local field="$3"
  python3 - "$manifest" "$scenario" "$field" <<'PY'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as handle:
    manifest = yaml.safe_load(handle)

for value in manifest.get("scenarioCapabilities", {}).get(sys.argv[2], {}).get(sys.argv[3], []):
    print(value)
PY
}

scenario_peers() {
  local target="$1"
  local scenario="$2"
  if [[ "${target}" != "all" ]]; then
    manifest_path "${target}" >/dev/null
    printf '%s\n' "${target}"
    return
  fi
  local manifest peer
  for manifest in "${PEERS_DIR}"/*/peer.yaml; do
    peer="$(basename "$(dirname "${manifest}")")"
    if scenario_supported_quiet "${manifest}" "${scenario}"; then
      printf '%s\n' "${peer}"
    fi
  done
}

peer_runtime_name() {
  local peer_type="$1"
  if [[ "${peer_type}" == "native" ]]; then
    printf 'peer-native\n'
  else
    printf 'peer-jvm\n'
  fi
}

local_runtime_name() {
  local runtime="$1"
  if [[ "${runtime}" == "native" ]]; then
    printf 'our-native\n'
  else
    printf 'our-jvm-jdk21\n'
  fi
}

ensure_container_network() {
  local runtime="$1"
  local network="${INTEROP_CONTAINER_NETWORK:-}"
  if [[ -z "${network}" ]]; then
    return 0
  fi
  if ! "${runtime}" network inspect "${network}" >/dev/null 2>&1; then
    "${runtime}" network create "${network}" >/dev/null
  fi
}

container_network_args() {
  local network="${INTEROP_CONTAINER_NETWORK:-}"
  if [[ -n "${network}" ]]; then
    printf '%s\n%s\n' "--network" "${network}"
  fi
}

container_host_gateway_args() {
  local host="${INTEROP_HOST_GATEWAY_NAME:-host.docker.internal}"
  local gateway="${INTEROP_HOST_GATEWAY_VALUE:-host-gateway}"
  if [[ -n "${host}" && -n "${gateway}" ]]; then
    printf '%s\n%s:%s\n' "--add-host" "${host}" "${gateway}"
  fi
}

report_label() {
  local scenario="$1"
  local role="$2"
  case "${scenario}-${role}" in
    *[!A-Za-z0-9._-]*|'') fail "scenario and role must contain only letters, digits, dot, underscore, or dash" ;;
    *) printf '%s-%s\n' "${scenario}" "${role}" ;;
  esac
}

write_interop_report() {
  python3 - "$@" <<'PY'
import json
import os
import sys

(
    report_file,
    peer,
    peer_version,
    scenario,
    idl,
    client_runtime,
    server_runtime,
    role,
    image,
    command,
    status,
    classification,
    exit_code,
    stdout_path,
    stderr_path,
    report_path,
    started_at,
    ended_at,
    notes,
) = sys.argv[1:]

data = {
    "peer": peer,
    "peerVersion": peer_version,
    "scenario": scenario,
    "idl": idl,
    "clientRuntime": client_runtime,
    "serverRuntime": server_runtime,
    "role": role,
    "image": image,
    "command": command,
    "status": status,
    "classification": classification,
    "exitCode": int(exit_code),
    "stdoutPath": stdout_path,
    "stderrPath": stderr_path,
    "reportPath": report_path,
    "startedAt": started_at,
    "endedAt": ended_at,
    "notes": notes,
}
os.makedirs(os.path.dirname(report_file), exist_ok=True)
with open(report_file, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2)
    handle.write("\n")
print(report_file)
PY
}

classify_failed_command() {
  local scenario="$1"
  local stderr_abs="$2"
  local default_message="$3"
  if [[ "${scenario}" == "rmi-iiop" ]] && [[ -f "${stderr_abs}" ]]; then
    if grep -Eq 'RmiIiopWireException|CdrException|wchar Code Set support not specified' "${stderr_abs}" \
        || (grep -q 'BAD_OPERATION' "${stderr_abs}" && grep -q 'PeerSmoke.verifyCalculator' "${stderr_abs}"); then
      printf 'our-bug\tG10-120 Java RMI-IIOP compatibility failure requires G10-120-080 project-owned defect closure\n'
      return
    fi
  fi
  printf 'infrastructure-failure\t%s\n' "${default_message}"
}

run_container_role() {
  local peer="$1"
  local role="$2"
  local scenario="$3"
  local report_role="${4:-${role}}"
  local client_runtime_override="${5:-}"
  local server_runtime_override="${6:-}"
  local manifest image peer_type peer_version container_command logs_dir iors_dir reports_dir
  manifest="$(manifest_path "${peer}")"
  image="$(manifest_value "${manifest}" "container.imageName")"
  peer_type="$(manifest_value "${manifest}" "peerType")"
  peer_version="$(manifest_value "${manifest}" "candidateOrigin.version")"
  container_command="$(manifest_value "${manifest}" "containerCommands.${role}")"
  logs_dir="$(manifest_value "${manifest}" "reports.logs")"
  iors_dir="$(manifest_value "${manifest}" "reports.iors")"
  reports_dir="$(manifest_value "${manifest}" "reports.structuredReports")"

  local label logs_abs iors_abs reports_abs stdout_abs stderr_abs report_abs
  label="$(report_label "${scenario}" "${report_role}")"
  logs_abs="${ROOT_DIR}/${logs_dir}"
  iors_abs="${ROOT_DIR}/${iors_dir}"
  reports_abs="${ROOT_DIR}/${reports_dir}"
  stdout_abs="${logs_abs}/${label}.stdout.log"
  stderr_abs="${logs_abs}/${label}.stderr.log"
  report_abs="${reports_abs}/${label}.json"
  mkdir -p "${logs_abs}" "${iors_abs}" "${reports_abs}"

  local stdout_rel stderr_rel report_rel idl peer_runtime client_runtime server_runtime started ended
  stdout_rel="${logs_dir}/${label}.stdout.log"
  stderr_rel="${logs_dir}/${label}.stderr.log"
  report_rel="${reports_dir}/${label}.json"
  idl="$(scenario_idl "${scenario}")"
  peer_runtime="$(peer_runtime_name "${peer_type}")"
  if [[ "${role}" == "client" ]]; then
    client_runtime="${peer_runtime}"
    server_runtime="our-jvm-jdk21"
  else
    client_runtime="our-jvm-jdk21"
    server_runtime="${peer_runtime}"
  fi
  if [[ -n "${client_runtime_override}" ]]; then
    client_runtime="${client_runtime_override}"
  fi
  if [[ -n "${server_runtime_override}" ]]; then
    server_runtime="${server_runtime_override}"
  fi

  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local gate_output runtime_output runtime
  if ! gate_output="$(validate_gates --require-cache "${peer}" 2>&1)"; then
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '%s\n' "${gate_output}" >"${stderr_abs}"
    : >"${stdout_abs}"
    write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
      "${client_runtime}" "${server_runtime}" "${report_role}" "${image}" "${container_command}" \
      "failed" "infrastructure-failure" "1" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
      "${started}" "${ended}" "G6-830 prerequisite validation failed"
    return 1
  fi

  local cache_paths
  cache_paths="$(resolve_cache_path "${peer}")"
  while IFS= read -r cache_path; do
    if [[ ! -f "${cache_path}" ]]; then
      ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      printf 'approved cache entry is missing after validation: %s\n' "${cache_path}" >"${stderr_abs}"
      : >"${stdout_abs}"
      write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
        "${client_runtime}" "${server_runtime}" "${report_role}" "${image}" "${container_command}" \
        "failed" "infrastructure-failure" "1" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
        "${started}" "${ended}" "G10-110 approved cache path resolution failed"
      return 1
    fi
  done <<<"${cache_paths}"

  local base_image_env base_image_value
  base_image_env="$(base_image_env_name "${peer_type}")"
  base_image_value="${!base_image_env:-}"
  if [[ -z "${base_image_value}" || "${base_image_value}" != *@sha256:* ]]; then
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '%s must be set to a digest-pinned image before live peer execution\n' \
      "${base_image_env}" >"${stderr_abs}"
    : >"${stdout_abs}"
    write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
      "${client_runtime}" "${server_runtime}" "${report_role}" "${image}" "${container_command}" \
      "failed" "infrastructure-failure" "1" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
      "${started}" "${ended}" "G6-830 base image validation failed"
    return 1
  fi

  if [[ -n "${DEFAULT_RUNTIME}" ]]; then
    runtime="${DEFAULT_RUNTIME}"
  elif command -v docker >/dev/null 2>&1; then
    runtime="docker"
  elif command -v podman >/dev/null 2>&1; then
    runtime="podman"
  else
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'CONTAINER_RUNTIME is unset and neither docker nor podman was found\n' >"${stderr_abs}"
    : >"${stdout_abs}"
    write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
      "${client_runtime}" "${server_runtime}" "${report_role}" "${image}" "${container_command}" \
      "failed" "infrastructure-failure" "1" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
      "${started}" "${ended}" "G6-830 container runtime resolution failed"
    return 1
  fi

  if ! "${runtime}" image inspect "${image}" >/dev/null 2>&1; then
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'peer image is missing; run build-image first: %s\n' "${image}" >"${stderr_abs}"
    : >"${stdout_abs}"
    write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
      "${client_runtime}" "${server_runtime}" "${report_role}" "${image}" "${container_command}" \
      "failed" "infrastructure-failure" "1" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
      "${started}" "${ended}" "G10-110 peer image validation failed"
    return 1
  fi
  if ! ensure_container_network "${runtime}" 2>"${stderr_abs}"; then
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    : >"${stdout_abs}"
    write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
      "${client_runtime}" "${server_runtime}" "${report_role}" "${image}" "${container_command}" \
      "failed" "infrastructure-failure" "1" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
      "${started}" "${ended}" "G10-120 container network setup failed"
    return 1
  fi

  local run_args=(
    run --rm
    -e "INTEROP_PEER=${peer}" \
    -e "INTEROP_ROLE=${role}" \
    -e "INTEROP_SCENARIO=${scenario}" \
    -v "${logs_abs}:/interop/logs" \
    -v "${iors_abs}:/interop/iors" \
    -v "${reports_abs}:/interop/reports" \
    -v "${INTEROP_ARTIFACT_CACHE}:/interop/artifacts:ro" \
  )
  while IFS= read -r network_arg; do
    run_args+=("${network_arg}")
  done < <(container_network_args)
  while IFS= read -r host_arg; do
    run_args+=("${host_arg}")
  done < <(container_host_gateway_args)
  case "${role}" in
    client|server|naming)
      run_args+=(-e "INTEROP_IDL=${idl}" -v "${ROOT_DIR}/${idl}:/interop/scenario.idl:ro")
      ;;
  esac
  run_args+=("${image}" "${container_command}")

  set +e
  "${runtime}" "${run_args[@]}" >"${stdout_abs}" 2>"${stderr_abs}"
  local exit_code=$?
  set -e
  ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  local status classification notes
  if [[ "${exit_code}" -eq 0 ]]; then
    status="passed"
    classification="expected-deferral"
    notes="G10-110 peer smoke command completed; scenario IDL was mounted but full scenario semantics require dedicated peer commands"
  elif [[ "${exit_code}" -eq 66 ]]; then
    status="failed"
    classification="missing-prerequisite"
    notes="G10-120 peer command reported a missing prerequisite"
  elif [[ "${exit_code}" -eq 67 ]]; then
    status="failed"
    classification="unsupported-scenario"
    notes="G10-120 peer command reported an unsupported scenario"
  else
    status="failed"
    local classified
    classified="$(classify_failed_command "${scenario}" "${stderr_abs}" "G10-110 container command failed")"
    classification="${classified%%$'\t'*}"
    notes="${classified#*$'\t'}"
  fi
  write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
    "${client_runtime}" "${server_runtime}" "${report_role}" "${image}" "${container_command}" \
    "${status}" "${classification}" "${exit_code}" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
    "${started}" "${ended}" "${notes}"
  return "${exit_code}"
}

STARTED_SERVER_CONTAINER=""
STARTED_SERVER_RUNTIME=""

start_server_role() {
  local peer="$1"
  local scenario="$2"
  local manifest image peer_type peer_version container_command logs_dir iors_dir reports_dir
  manifest="$(manifest_path "${peer}")"
  image="$(manifest_value "${manifest}" "container.imageName")"
  peer_type="$(manifest_value "${manifest}" "peerType")"
  peer_version="$(manifest_value "${manifest}" "candidateOrigin.version")"
  container_command="$(manifest_value "${manifest}" "containerCommands.server")"
  logs_dir="$(manifest_value "${manifest}" "reports.logs")"
  iors_dir="$(manifest_value "${manifest}" "reports.iors")"
  reports_dir="$(manifest_value "${manifest}" "reports.structuredReports")"

  local label logs_abs iors_abs reports_abs stdout_abs stderr_abs report_abs
  label="$(report_label "${scenario}" "server")"
  logs_abs="${ROOT_DIR}/${logs_dir}"
  iors_abs="${ROOT_DIR}/${iors_dir}"
  reports_abs="${ROOT_DIR}/${reports_dir}"
  stdout_abs="${logs_abs}/${label}.stdout.log"
  stderr_abs="${logs_abs}/${label}.stderr.log"
  report_abs="${reports_abs}/${label}.json"
  mkdir -p "${logs_abs}" "${iors_abs}" "${reports_abs}"

  local stdout_rel stderr_rel report_rel idl peer_runtime started ended
  stdout_rel="${logs_dir}/${label}.stdout.log"
  stderr_rel="${logs_dir}/${label}.stderr.log"
  report_rel="${reports_dir}/${label}.json"
  idl="$(scenario_idl "${scenario}")"
  peer_runtime="$(peer_runtime_name "${peer_type}")"
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  local gate_output runtime
  if ! gate_output="$(validate_gates --require-cache "${peer}" 2>&1)"; then
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '%s\n' "${gate_output}" >"${stderr_abs}"
    : >"${stdout_abs}"
    write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
      "our-jvm-jdk21" "${peer_runtime}" "server" "${image}" "${container_command}" \
      "failed" "infrastructure-failure" "1" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
      "${started}" "${ended}" "G10-110 prerequisite validation failed"
    return 1
  fi

  local base_image_env base_image_value
  base_image_env="$(base_image_env_name "${peer_type}")"
  base_image_value="${!base_image_env:-}"
  if [[ -z "${base_image_value}" || "${base_image_value}" != *@sha256:* ]]; then
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '%s must be set to a digest-pinned image before live peer execution\n' \
      "${base_image_env}" >"${stderr_abs}"
    : >"${stdout_abs}"
    write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
      "our-jvm-jdk21" "${peer_runtime}" "server" "${image}" "${container_command}" \
      "failed" "infrastructure-failure" "1" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
      "${started}" "${ended}" "G10-110 base image validation failed"
    return 1
  fi

  if [[ -n "${DEFAULT_RUNTIME}" ]]; then
    runtime="${DEFAULT_RUNTIME}"
  elif command -v docker >/dev/null 2>&1; then
    runtime="docker"
  elif command -v podman >/dev/null 2>&1; then
    runtime="podman"
  else
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'CONTAINER_RUNTIME is unset and neither docker nor podman was found\n' >"${stderr_abs}"
    : >"${stdout_abs}"
    write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
      "our-jvm-jdk21" "${peer_runtime}" "server" "${image}" "${container_command}" \
      "failed" "infrastructure-failure" "1" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
      "${started}" "${ended}" "G10-110 container runtime resolution failed"
    return 1
  fi

  if ! "${runtime}" image inspect "${image}" >/dev/null 2>&1; then
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'peer image is missing; run build-image first: %s\n' "${image}" >"${stderr_abs}"
    : >"${stdout_abs}"
    write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
      "our-jvm-jdk21" "${peer_runtime}" "server" "${image}" "${container_command}" \
      "failed" "infrastructure-failure" "1" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
      "${started}" "${ended}" "G10-110 peer image validation failed"
    return 1
  fi
  if ! ensure_container_network "${runtime}" 2>"${stderr_abs}"; then
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    : >"${stdout_abs}"
    write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
      "our-jvm-jdk21" "${peer_runtime}" "server" "${image}" "${container_command}" \
      "failed" "infrastructure-failure" "1" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
      "${started}" "${ended}" "G10-120 container network setup failed"
    return 1
  fi

  local server_ior safe_peer safe_scenario container_name host_port
  server_ior="${iors_abs}/${scenario}-server.ior"
  rm -f "${server_ior}"
  safe_peer="${peer//[!A-Za-z0-9_.-]/-}"
  safe_scenario="${scenario//[!A-Za-z0-9_.-]/-}"
  container_name="mjo-${safe_peer}-${safe_scenario}-server-$$"
  host_port="${INTEROP_PEER_SERVER_HOST_PORT:-2809}"
  set +e
  local server_run_args=(
    run -d --name "${container_name}" --hostname "${container_name}"
    -p "127.0.0.1:${host_port}:2809"
  )
  while IFS= read -r network_arg; do
    server_run_args+=("${network_arg}")
  done < <(container_network_args)
  while IFS= read -r host_arg; do
    server_run_args+=("${host_arg}")
  done < <(container_host_gateway_args)
  "${runtime}" "${server_run_args[@]}" \
    -e "INTEROP_PEER=${peer}" \
    -e "INTEROP_ROLE=server" \
    -e "INTEROP_SCENARIO=${scenario}" \
    -e "INTEROP_IDL=${idl}" \
    -v "${logs_abs}:/interop/logs" \
    -v "${iors_abs}:/interop/iors" \
    -v "${reports_abs}:/interop/reports" \
    -v "${ROOT_DIR}/${idl}:/interop/scenario.idl:ro" \
    -v "${INTEROP_ARTIFACT_CACHE}:/interop/artifacts:ro" \
    "${image}" "${container_command}" >"${stdout_abs}" 2>"${stderr_abs}"
  local exit_code=$?
  set -e
  ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  if [[ "${exit_code}" -eq 0 ]]; then
    STARTED_SERVER_CONTAINER="${container_name}"
    STARTED_SERVER_RUNTIME="${runtime}"
    local ior_attempts ior_delay ior_attempt
    ior_attempts="${INTEROP_PEER_SERVER_IOR_ATTEMPTS:-30}"
    ior_delay="${INTEROP_PEER_SERVER_IOR_DELAY_SECONDS:-1}"
    for ((ior_attempt = 1; ior_attempt <= ior_attempts; ior_attempt++)); do
      if [[ -s "${server_ior}" ]]; then
        break
      fi
      if "${runtime}" exec "${container_name}" test -s "/interop/iors/${scenario}-server.ior" \
          >/dev/null 2>&1; then
        local copied_ior
        copied_ior="${server_ior}.copy.$$"
        "${runtime}" exec "${container_name}" cat "/interop/iors/${scenario}-server.ior" \
          >"${copied_ior}" 2>/dev/null || true
        if [[ -s "${copied_ior}" ]]; then
          mv "${copied_ior}" "${server_ior}"
          break
        fi
        rm -f "${copied_ior}"
      fi
      sleep "${ior_delay}"
    done
    if [[ ! -s "${server_ior}" ]]; then
      printf 'peer server did not write a non-empty IOR before health checks: %s\n' \
        "${server_ior}" >"${stderr_abs}"
      write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
        "our-jvm-jdk21" "${peer_runtime}" "server" "${image}" "${container_command}" \
        "failed" "infrastructure-failure" "1" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
        "${started}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "G10-120 peer server IOR was not ready before health checks"
      return 1
    fi
    write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
      "our-jvm-jdk21" "${peer_runtime}" "server" "${image}" "${container_command}" \
      "passed" "expected-deferral" "0" "${stdout_rel}" "${stderr_rel}" "${report_rel}" \
      "${started}" "${ended}" "G10-110 server container started"
    return 0
  fi

  write_interop_report "${report_abs}" "${peer}" "${peer_version}" "${scenario}" "${idl}" \
    "our-jvm-jdk21" "${peer_runtime}" "server" "${image}" "${container_command}" \
    "failed" "infrastructure-failure" "${exit_code}" "${stdout_rel}" "${stderr_rel}" \
    "${report_rel}" "${started}" "${ended}" "G10-110 server container failed to start"
  return "${exit_code}"
}

cleanup_started_server() {
  if [[ -n "${STARTED_SERVER_CONTAINER}" && -n "${STARTED_SERVER_RUNTIME}" ]]; then
    "${STARTED_SERVER_RUNTIME}" rm -f "${STARTED_SERVER_CONTAINER}" >/dev/null 2>&1 || true
  fi
  STARTED_SERVER_CONTAINER=""
  STARTED_SERVER_RUNTIME=""
}

wait_for_peer_health() {
  local peer="$1"
  local scenario="$2"
  local attempts="${INTEROP_HEALTH_ATTEMPTS:-5}"
  local delay="${INTEROP_HEALTH_DELAY_SECONDS:-1}"
  local attempt
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    if run_container_role "${peer}" "health" "${scenario}"; then
      return 0
    fi
    sleep "${delay}"
  done
  return 1
}

run_live_peer_scenario() {
  local peer="$1"
  local scenario="$2"
  STARTED_SERVER_CONTAINER=""
  STARTED_SERVER_RUNTIME=""
  if ! start_server_role "${peer}" "${scenario}"; then
    return 1
  fi
  if ! wait_for_peer_health "${peer}" "${scenario}"; then
    cleanup_started_server
    return 1
  fi
  local result=0
  run_container_role "${peer}" "client" "${scenario}" || result=$?
  cleanup_started_server
  return "${result}"
}

summarize_reports() {
  local peer="$1"
  local manifest reports_dir reports_abs summary_abs
  manifest="$(manifest_path "${peer}")"
  reports_dir="$(manifest_value "${manifest}" "reports.structuredReports")"
  reports_abs="${ROOT_DIR}/${reports_dir}"
  summary_abs="${reports_abs}/summary.json"
  mkdir -p "${reports_abs}"
  python3 - "${reports_abs}" "${summary_abs}" "${peer}" <<'PY'
import glob
import json
import os
import sys

reports_dir, summary_path, peer = sys.argv[1:]
reports = []
for path in sorted(glob.glob(os.path.join(reports_dir, "*.json"))):
    if os.path.basename(path) == "summary.json":
        continue
    with open(path, encoding="utf-8") as handle:
        report = json.load(handle)
    if "reportPath" in report:
        reports.append(report)
classification_counts = {}
status_counts = {}
scenario_counts = {}
failure_reports = []
for item in reports:
    classification = item.get("classification", "missing-classification")
    status = item.get("status", "missing-status")
    scenario = item.get("scenario", "missing-scenario")
    classification_counts[classification] = classification_counts.get(classification, 0) + 1
    status_counts[status] = status_counts.get(status, 0) + 1
    scenario_counts[scenario] = scenario_counts.get(scenario, 0) + 1
    if status != "passed" or classification in {"our-bug", "peer-bug", "spec-ambiguity", "profile-mismatch"}:
        failure_reports.append(
            {
                "reportPath": item.get("reportPath", ""),
                "scenario": scenario,
                "role": item.get("role", ""),
                "status": status,
                "classification": classification,
                "notes": item.get("notes", item.get("message", "")),
            }
        )
summary = {
    "peer": peer,
    "reportCount": len(reports),
    "statusCounts": dict(sorted(status_counts.items())),
    "classificationCounts": dict(sorted(classification_counts.items())),
    "scenarioCounts": dict(sorted(scenario_counts.items())),
    "reports": [item.get("reportPath", "") for item in reports],
    "failures": failure_reports,
}
with open(summary_path, "w", encoding="utf-8") as handle:
    json.dump(summary, handle, indent=2)
    handle.write("\n")
print(summary_path)
PY
}

native_lane_report() {
  local dry_run
  dry_run="$(parse_dry_run "$@")"
  if [[ "${1:-}" == "--dry-run" ]]; then
    shift
  fi
  local scenario="${1:-}"
  local role="${2:-}"
  [[ -n "${scenario}" && -n "${role}" ]] || fail "native-lane-report requires a scenario and client|server"
  case "${role}" in
    client|server) ;;
    *) fail "native-lane-report role must be client or server" ;;
  esac

  local reports_dir logs_dir label report_abs stdout_abs stderr_abs binary_env binary idl started ended exit_code status classification message
  reports_dir="build/interop/native/reports"
  logs_dir="build/interop/native/logs"
  label="$(report_label "${scenario}" "native-${role}")"
  report_abs="${ROOT_DIR}/${reports_dir}/${label}.json"
  stdout_abs="${ROOT_DIR}/${logs_dir}/${label}.stdout.log"
  stderr_abs="${ROOT_DIR}/${logs_dir}/${label}.stderr.log"
  binary_env="MJO_NATIVE_${role^^}_BINARY"
  binary="${!binary_env:-}"
  idl="$(scenario_idl "${scenario}")"

  if [[ "${dry_run}" == "true" ]]; then
    echo "dry-run: would validate ${binary_env} for ${scenario} ${role}"
    echo "dry-run: would write ${reports_dir}/${label}.json"
    return
  fi

  mkdir -p "$(dirname "${report_abs}")" "$(dirname "${stdout_abs}")" "$(dirname "${stderr_abs}")"
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [[ -z "${binary}" || ! -x "${binary}" ]]; then
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    : >"${stdout_abs}"
    printf '%s must point to an executable native interop binary\n' "${binary_env}" >"${stderr_abs}"
    if [[ "${role}" == "client" ]]; then
      write_interop_report "${report_abs}" "mundane-java-orb" "local" "${scenario}" "${idl}" \
        "our-native" "our-jvm-jdk21" "native-client" "local-native-image" "${binary_env}" \
        "failed" "infrastructure-failure" "1" "${logs_dir}/${label}.stdout.log" \
        "${logs_dir}/${label}.stderr.log" "${reports_dir}/${label}.json" "${started}" "${ended}" \
        "G10-100 native client binary prerequisite missing"
    else
      write_interop_report "${report_abs}" "mundane-java-orb" "local" "${scenario}" "${idl}" \
        "our-jvm-jdk21" "our-native" "native-server" "local-native-image" "${binary_env}" \
        "failed" "infrastructure-failure" "1" "${logs_dir}/${label}.stdout.log" \
        "${logs_dir}/${label}.stderr.log" "${reports_dir}/${label}.json" "${started}" "${ended}" \
        "G10-100 native server binary prerequisite missing"
    fi
    return 1
  fi

  set +e
  "${binary}" >"${stdout_abs}" 2>"${stderr_abs}"
  exit_code="$?"
  set -e
  ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [[ "${exit_code}" == "0" ]]; then
    status="passed"
    classification="expected-deferral"
    message="G10-100 native ${role} binary prerequisite satisfied"
  else
    status="failed"
    classification="infrastructure-failure"
    message="G10-100 native ${role} binary exited with code ${exit_code}"
  fi
  if [[ "${role}" == "client" ]]; then
    write_interop_report "${report_abs}" "mundane-java-orb" "local" "${scenario}" "${idl}" \
      "our-native" "our-jvm-jdk21" "native-client" "local-native-image" "${binary}" \
      "${status}" "${classification}" "${exit_code}" "${logs_dir}/${label}.stdout.log" \
      "${logs_dir}/${label}.stderr.log" "${reports_dir}/${label}.json" "${started}" "${ended}" \
      "${message}"
  else
    write_interop_report "${report_abs}" "mundane-java-orb" "local" "${scenario}" "${idl}" \
      "our-jvm-jdk21" "our-native" "native-server" "local-native-image" "${binary}" \
      "${status}" "${classification}" "${exit_code}" "${logs_dir}/${label}.stdout.log" \
      "${logs_dir}/${label}.stderr.log" "${reports_dir}/${label}.json" "${started}" "${ended}" \
      "${message}"
  fi
  return "${exit_code}"
}

local_lane_report() {
  local dry_run
  dry_run="$(parse_dry_run "$@")"
  if [[ "${1:-}" == "--dry-run" ]]; then
    shift
  fi
  local scenario="${1:-}"
  local runtime="${2:-}"
  local role="${3:-}"
  local peer="${4:-local}"
  local direction="${5:-prerequisite}"
  [[ -n "${scenario}" && -n "${runtime}" && -n "${role}" ]] \
    || fail "local-lane-report requires a scenario, jvm|native, and client|server"
  case "${runtime}" in
    jvm|native) ;;
    *) fail "local-lane-report runtime must be jvm or native" ;;
  esac
  case "${role}" in
    client|server) ;;
    *) fail "local-lane-report role must be client or server" ;;
  esac

  local reports_dir logs_dir label report_abs stdout_abs stderr_abs command_env command idl
  local started ended exit_code status classification message client_runtime server_runtime
  local our_runtime
  our_runtime="$(local_runtime_name "${runtime}")"
  reports_dir="build/interop/local/reports"
  logs_dir="build/interop/local/logs"
  label="$(report_label "${scenario}" "${peer}-${runtime}-${role}-${direction}")"
  report_abs="${ROOT_DIR}/${reports_dir}/${label}.json"
  stdout_abs="${ROOT_DIR}/${logs_dir}/${label}.stdout.log"
  stderr_abs="${ROOT_DIR}/${logs_dir}/${label}.stderr.log"
  if [[ "${runtime}" == "jvm" ]]; then
    command_env="MJO_JVM_${role^^}_COMMAND"
    command="${!command_env:-}"
  else
    command_env="MJO_NATIVE_${role^^}_BINARY"
    command="${!command_env:-}"
  fi
  idl="$(scenario_idl "${scenario}")"

  if [[ "${dry_run}" == "true" ]]; then
    echo "dry-run: would validate ${command_env} for ${scenario} ${role}"
    echo "dry-run: would write ${reports_dir}/${label}.json"
    return
  fi

  mkdir -p "$(dirname "${report_abs}")" "$(dirname "${stdout_abs}")" "$(dirname "${stderr_abs}")"
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [[ -z "${command}" || ( "${runtime}" == "native" && ! -x "${command}" ) ]]; then
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    : >"${stdout_abs}"
    printf '%s must provide the %s %s lane command\n' "${command_env}" "${runtime}" "${role}" >"${stderr_abs}"
    if [[ "${role}" == "client" ]]; then
      client_runtime="${our_runtime}"
      server_runtime="${peer}-server"
    else
      client_runtime="${peer}-client"
      server_runtime="${our_runtime}"
    fi
    write_interop_report "${report_abs}" "mundane-java-orb" "local" "${scenario}" "${idl}" \
      "${client_runtime}" "${server_runtime}" "${runtime}-${role}-${direction}" "local-${runtime}" "${command_env}" \
      "failed" "infrastructure-failure" "1" "${logs_dir}/${label}.stdout.log" \
      "${logs_dir}/${label}.stderr.log" "${reports_dir}/${label}.json" "${started}" "${ended}" \
      "G10-120 ${runtime} ${role} command prerequisite missing"
    return 1
  fi

  local peer_iors_dir server_ior
  peer_iors_dir="${ROOT_DIR}/build/interop/local/iors"
  if [[ "${peer}" != "local" ]]; then
    peer_iors_dir="${ROOT_DIR}/$(manifest_value "$(manifest_path "${peer}")" "reports.iors")"
  fi
  server_ior="${peer_iors_dir}/${scenario}-server.ior"
  set +e
  if [[ "${runtime}" == "jvm" ]]; then
    env \
      "MJO_INTEROP_SCENARIO=${scenario}" \
      "MJO_INTEROP_PEER=${peer}" \
      "MJO_INTEROP_DIRECTION=${direction}" \
      "MJO_INTEROP_IDL=${ROOT_DIR}/${idl}" \
      "MJO_INTEROP_IORS_DIR=${peer_iors_dir}" \
      "MJO_INTEROP_SERVER_IOR=${server_ior}" \
      "MJO_INTEROP_ENDPOINT_HOST_OVERRIDE=${INTEROP_PEER_SERVER_HOST:-127.0.0.1}" \
      "MJO_INTEROP_ENDPOINT_PORT_OVERRIDE=${INTEROP_PEER_SERVER_HOST_PORT:-2809}" \
      bash -c "${command}" >"${stdout_abs}" 2>"${stderr_abs}"
  else
    env \
      "MJO_INTEROP_SCENARIO=${scenario}" \
      "MJO_INTEROP_PEER=${peer}" \
      "MJO_INTEROP_DIRECTION=${direction}" \
      "MJO_INTEROP_IDL=${ROOT_DIR}/${idl}" \
      "MJO_INTEROP_IORS_DIR=${peer_iors_dir}" \
      "MJO_INTEROP_SERVER_IOR=${server_ior}" \
      "MJO_INTEROP_ENDPOINT_HOST_OVERRIDE=${INTEROP_PEER_SERVER_HOST:-127.0.0.1}" \
      "MJO_INTEROP_ENDPOINT_PORT_OVERRIDE=${INTEROP_PEER_SERVER_HOST_PORT:-2809}" \
      "${command}" >"${stdout_abs}" 2>"${stderr_abs}"
  fi
  exit_code="$?"
  set -e
  ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [[ "${exit_code}" == "0" ]]; then
    status="passed"
    classification="expected-deferral"
    message="G10-120 ${runtime} ${role} lane command completed for ${direction}"
  else
    status="failed"
    local classified
    classified="$(
      classify_failed_command \
        "${scenario}" \
        "${stderr_abs}" \
        "G10-120 ${runtime} ${role} lane command exited with code ${exit_code}"
    )"
    classification="${classified%%$'\t'*}"
    message="${classified#*$'\t'}"
  fi
  if [[ "${role}" == "client" ]]; then
    client_runtime="${our_runtime}"
    server_runtime="${peer}-server"
  else
    client_runtime="${peer}-client"
    server_runtime="${our_runtime}"
  fi
  write_interop_report "${report_abs}" "mundane-java-orb" "local" "${scenario}" "${idl}" \
    "${client_runtime}" "${server_runtime}" "${runtime}-${role}-${direction}" "local-${runtime}" "${command_env}" \
    "${status}" "${classification}" "${exit_code}" "${logs_dir}/${label}.stdout.log" \
    "${logs_dir}/${label}.stderr.log" "${reports_dir}/${label}.json" "${started}" "${ended}" \
    "${message}"
  return "${exit_code}"
}

STARTED_LOCAL_SERVER_PID=""

cleanup_started_local_server() {
  if [[ -n "${STARTED_LOCAL_SERVER_PID}" ]] && kill -0 "${STARTED_LOCAL_SERVER_PID}" >/dev/null 2>&1; then
    kill "${STARTED_LOCAL_SERVER_PID}" >/dev/null 2>&1 || true
    wait "${STARTED_LOCAL_SERVER_PID}" >/dev/null 2>&1 || true
  fi
  STARTED_LOCAL_SERVER_PID=""
}

start_local_server_lane() {
  local scenario="$1"
  local runtime="$2"
  local peer="$3"
  local direction="local-server-to-peer-client"
  local reports_dir logs_dir peer_iors_dir label report_abs stdout_abs stderr_abs command_env command idl
  local our_runtime
  our_runtime="$(local_runtime_name "${runtime}")"
  reports_dir="build/interop/local/reports"
  logs_dir="build/interop/local/logs"
  peer_iors_dir="${ROOT_DIR}/$(manifest_value "$(manifest_path "${peer}")" "reports.iors")"
  label="$(report_label "${scenario}" "${peer}-${runtime}-server-${direction}")"
  report_abs="${ROOT_DIR}/${reports_dir}/${label}.json"
  stdout_abs="${ROOT_DIR}/${logs_dir}/${label}.stdout.log"
  stderr_abs="${ROOT_DIR}/${logs_dir}/${label}.stderr.log"
  mkdir -p "$(dirname "${report_abs}")" "$(dirname "${stdout_abs}")" "${peer_iors_dir}"
  idl="$(scenario_idl "${scenario}")"
  if [[ "${runtime}" == "jvm" ]]; then
    command_env="MJO_JVM_SERVER_COMMAND"
    command="${!command_env:-}"
  else
    command_env="MJO_NATIVE_SERVER_BINARY"
    command="${!command_env:-}"
  fi

  local started ended
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [[ -z "${command}" || ( "${runtime}" == "native" && ! -x "${command}" ) ]]; then
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    : >"${stdout_abs}"
    printf '%s must provide a live %s server lane\n' "${command_env}" "${runtime}" >"${stderr_abs}"
    write_interop_report "${report_abs}" "mundane-java-orb" "local" "${scenario}" "${idl}" \
      "${peer}-client" "${our_runtime}" "${runtime}-server-${direction}" "local-${runtime}" "${command_env}" \
      "failed" "infrastructure-failure" "1" "${logs_dir}/${label}.stdout.log" \
      "${logs_dir}/${label}.stderr.log" "${reports_dir}/${label}.json" "${started}" "${ended}" \
      "G10-120 ${runtime} server command prerequisite missing"
    return 1
  fi

  local server_ior="${peer_iors_dir}/${scenario}-server.ior"
  rm -f "${server_ior}"
  set +e
  if [[ "${runtime}" == "jvm" ]]; then
    env \
      "MJO_INTEROP_SCENARIO=${scenario}" \
      "MJO_INTEROP_PEER=${peer}" \
      "MJO_INTEROP_DIRECTION=${direction}" \
      "MJO_INTEROP_IDL=${ROOT_DIR}/${idl}" \
      "MJO_INTEROP_IORS_DIR=${peer_iors_dir}" \
      "MJO_INTEROP_SERVER_IOR=${server_ior}" \
      bash -c "${command}" >"${stdout_abs}" 2>"${stderr_abs}" &
  else
    env \
      "MJO_INTEROP_SCENARIO=${scenario}" \
      "MJO_INTEROP_PEER=${peer}" \
      "MJO_INTEROP_DIRECTION=${direction}" \
      "MJO_INTEROP_IDL=${ROOT_DIR}/${idl}" \
      "MJO_INTEROP_IORS_DIR=${peer_iors_dir}" \
      "MJO_INTEROP_SERVER_IOR=${server_ior}" \
      "${command}" >"${stdout_abs}" 2>"${stderr_abs}" &
  fi
  STARTED_LOCAL_SERVER_PID="$!"
  set -e
  sleep "${INTEROP_LOCAL_SERVER_START_DELAY_SECONDS:-1}"
  if ! kill -0 "${STARTED_LOCAL_SERVER_PID}" >/dev/null 2>&1; then
    local exit_code
    set +e
    wait "${STARTED_LOCAL_SERVER_PID}"
    exit_code="$?"
    set -e
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    write_interop_report "${report_abs}" "mundane-java-orb" "local" "${scenario}" "${idl}" \
      "${peer}-client" "${our_runtime}" "${runtime}-server-${direction}" "local-${runtime}" "${command_env}" \
      "failed" "infrastructure-failure" "${exit_code}" "${logs_dir}/${label}.stdout.log" \
      "${logs_dir}/${label}.stderr.log" "${reports_dir}/${label}.json" "${started}" "${ended}" \
      "G10-120 ${runtime} server lane exited before peer client execution"
    STARTED_LOCAL_SERVER_PID=""
    return 1
  fi
  local attempts delay attempt
  attempts="${INTEROP_LOCAL_SERVER_IOR_ATTEMPTS:-20}"
  delay="${INTEROP_LOCAL_SERVER_IOR_DELAY_SECONDS:-1}"
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    if [[ -s "${server_ior}" ]]; then
      break
    fi
    sleep "${delay}"
  done
  if [[ ! -s "${server_ior}" ]]; then
    ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'local %s server did not write a non-empty IOR before peer client execution: %s\n' \
      "${runtime}" "${server_ior}" >"${stderr_abs}"
    write_interop_report "${report_abs}" "mundane-java-orb" "local" "${scenario}" "${idl}" \
      "${peer}-client" "${our_runtime}" "${runtime}-server-${direction}" "local-${runtime}" "${command_env}" \
      "failed" "infrastructure-failure" "1" "${logs_dir}/${label}.stdout.log" \
      "${logs_dir}/${label}.stderr.log" "${reports_dir}/${label}.json" "${started}" "${ended}" \
      "G10-120 ${runtime} server IOR was not ready before peer client execution"
    return 1
  fi
  ended="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  write_interop_report "${report_abs}" "mundane-java-orb" "local" "${scenario}" "${idl}" \
    "${peer}-client" "${our_runtime}" "${runtime}-server-${direction}" "local-${runtime}" "${command_env}" \
    "passed" "expected-deferral" "0" "${logs_dir}/${label}.stdout.log" \
    "${logs_dir}/${label}.stderr.log" "${reports_dir}/${label}.json" "${started}" "${ended}" \
    "G10-120 ${runtime} server lane started for peer client execution"
}

parse_dry_run() {
  local dry_run="false"
  if [[ "${1:-}" == "--dry-run" ]]; then
    dry_run="true"
    shift
  fi
  printf '%s\n' "${dry_run}"
}

prepare_cache() {
  local dry_run
  dry_run="$(parse_dry_run "$@")"
  if [[ "${1:-}" == "--dry-run" ]]; then
    shift
  fi
  local peer="${1:-}"
  if [[ "${dry_run}" == "true" ]]; then
    if [[ -n "${peer}" ]]; then
      echo "dry-run: would validate approved cache for ${peer}"
    else
      echo "dry-run: would validate approved cache for all peers"
    fi
    return
  fi
  if [[ -n "${peer}" ]]; then
    validate_gates --require-cache "${peer}"
  else
    validate_gates --require-cache
  fi
}

build_image() {
  local dry_run
  dry_run="$(parse_dry_run "$@")"
  if [[ "${1:-}" == "--dry-run" ]]; then
    shift
  fi
  local peer="${1:-}"
  [[ -n "${peer}" ]] || fail "build-image requires a peer"

  local manifest image build_file peer_type base_image
  manifest="$(manifest_path "${peer}")"
  image="$(manifest_value "${manifest}" "container.imageName")"
  build_file="$(manifest_value "${manifest}" "container.buildFile")"
  peer_type="$(manifest_value "${manifest}" "peerType")"

  if [[ "${dry_run}" == "true" ]]; then
    echo "dry-run: would build ${image} using ${build_file}"
    return
  fi

  local runtime
  base_image="$(require_digest_pinned_base_image "${peer_type}")"
  require_external_artifact_cache
  validate_gates --require-cache "${peer}" >/dev/null
  stage_artifact_cache_for_build "${peer}"
  runtime="$(resolve_runtime)"
  "${runtime}" build \
    --build-arg "INTEROP_BASE_IMAGE=${base_image}" \
    --build-arg "INTEROP_PEER=${peer}" \
    --file "${ROOT_DIR}/${build_file}" \
    --tag "${image}" \
    "${ROOT_DIR}"
}

launch_peer() {
  local dry_run
  dry_run="$(parse_dry_run "$@")"
  if [[ "${1:-}" == "--dry-run" ]]; then
    shift
  fi
  local peer="${1:-}"
  local role="${2:-}"
  local scenario="${3:-manual}"
  [[ -n "${peer}" ]] || fail "launch requires a peer"
  case "${role}" in
    client|server|naming) ;;
    *) fail "launch role must be client, server, or naming" ;;
  esac

  local manifest image command_path logs_dir iors_dir reports_dir
  manifest="$(manifest_path "${peer}")"
  image="$(manifest_value "${manifest}" "container.imageName")"
  command_path="$(manifest_value "${manifest}" "launch.${role}Command")"
  logs_dir="$(manifest_value "${manifest}" "reports.logs")"
  iors_dir="$(manifest_value "${manifest}" "reports.iors")"
  reports_dir="$(manifest_value "${manifest}" "reports.structuredReports")"

  if [[ "${dry_run}" == "true" ]]; then
    echo "dry-run: would launch ${role} for ${peer} from ${image}"
    echo "dry-run: command ${command_path}"
    echo "dry-run: outputs ${logs_dir}, ${iors_dir}, ${reports_dir}"
    return
  fi

  run_container_role "${peer}" "${role}" "${scenario}"
}

health_peer() {
  local dry_run
  dry_run="$(parse_dry_run "$@")"
  if [[ "${1:-}" == "--dry-run" ]]; then
    shift
  fi
  local peer="${1:-}"
  [[ -n "${peer}" ]] || fail "health requires a peer"

  local manifest readiness
  manifest="$(manifest_path "${peer}")"
  readiness="$(manifest_value "${manifest}" "launch.readinessCheck")"
  if [[ "${dry_run}" == "true" ]]; then
    echo "dry-run: would run readiness check ${readiness} for ${peer}"
    return
  fi

  run_container_role "${peer}" "health" "health"
}

report_peer() {
  local dry_run
  dry_run="$(parse_dry_run "$@")"
  if [[ "${1:-}" == "--dry-run" ]]; then
    shift
  fi
  local peer="${1:-}"
  [[ -n "${peer}" ]] || fail "report requires a peer"

  local manifest reports_dir
  manifest="$(manifest_path "${peer}")"
  reports_dir="$(manifest_value "${manifest}" "reports.structuredReports")"
  if [[ "${dry_run}" == "true" ]]; then
    echo "dry-run: would create structured report under ${reports_dir}"
    return
  fi

  run_container_role "${peer}" "report" "report" || return 1
  summarize_reports "${peer}"
}

run_scenario() {
  local dry_run="false"
  local require_live="false"
  while [[ "${1:-}" == "--dry-run" || "${1:-}" == "--require-live" ]]; do
    case "${1}" in
      --dry-run) dry_run="true" ;;
      --require-live) require_live="true" ;;
    esac
    shift
  done
  local scenario="${1:-}"
  local target="${2:-}"
  [[ -n "${scenario}" && -n "${target}" ]] || fail "run-scenario requires a scenario and peer|all"

  local peers=()
  mapfile -t peers < <(scenario_peers "${target}" "${scenario}")
  if [[ "${#peers[@]}" -eq 0 ]]; then
    fail "no approved peers declare scenario: ${scenario}"
  fi

  local failures=0
  local peer role
  for peer in "${peers[@]}"; do
    scenario_supported "$(manifest_path "${peer}")" "${scenario}"
    if [[ "${dry_run}" == "true" ]]; then
      for role in server health client; do
        echo "dry-run: would run scenario ${scenario} role ${role} for ${peer}"
      done
    elif ! run_live_peer_scenario "${peer}" "${scenario}"; then
      failures=$((failures + 1))
    fi
  done
  if [[ "${require_live}" == "true" && "${failures}" -gt 0 ]]; then
    return 1
  fi
}

run_direction_matrix() {
  local dry_run="false"
  local require_live="false"
  while [[ "${1:-}" == "--dry-run" || "${1:-}" == "--require-live" ]]; do
    case "${1}" in
      --dry-run) dry_run="true" ;;
      --require-live) require_live="true" ;;
    esac
    shift
  done
  local scenario="${1:-}"
  local target="${2:-}"
  [[ -n "${scenario}" && -n "${target}" ]] || fail "run-direction-matrix requires a scenario and peer|all"

  local peers=()
  mapfile -t peers < <(scenario_peers "${target}" "${scenario}")
  if [[ "${#peers[@]}" -eq 0 ]]; then
    fail "no approved peers declare scenario: ${scenario}"
  fi

  local failures=0
  local runtime peer
  for peer in "${peers[@]}"; do
    scenario_supported "$(manifest_path "${peer}")" "${scenario}"
  done

  for peer in "${peers[@]}"; do
    if [[ "${dry_run}" == "true" ]]; then
      if scenario_capability_contains "$(manifest_path "${peer}")" "${scenario}" "directions" \
          "peer-server-to-local-client"; then
        echo "dry-run: would start ${peer} server for ${scenario}"
        echo "dry-run: would run ${peer} health check for ${scenario}"
        if scenario_capability_contains "$(manifest_path "${peer}")" "${scenario}" "localRuntimes" "jvm"; then
          local_lane_report --dry-run "${scenario}" "jvm" "client" "${peer}" "peer-server-to-local-client"
        fi
        if scenario_capability_contains "$(manifest_path "${peer}")" "${scenario}" "localRuntimes" "native"; then
          local_lane_report --dry-run "${scenario}" "native" "client" "${peer}" "peer-server-to-local-client"
        fi
        echo "dry-run: would stop ${peer} server for ${scenario}"
      fi
      if scenario_capability_contains "$(manifest_path "${peer}")" "${scenario}" "directions" \
          "local-server-to-peer-client"; then
        while IFS= read -r runtime; do
          if [[ "${runtime}" == "jvm" ]]; then
            echo "dry-run: would validate MJO_JVM_SERVER_COMMAND for ${scenario} server"
          else
            echo "dry-run: would validate MJO_NATIVE_SERVER_BINARY for ${scenario} server"
          fi
          echo "dry-run: would start our ${runtime} server for ${scenario} and ${peer}"
          echo "dry-run: would run ${peer} client against our ${runtime} server for ${scenario}"
          echo "dry-run: would stop our ${runtime} server for ${scenario} and ${peer}"
        done < <(scenario_capability_values "$(manifest_path "${peer}")" "${scenario}" "localRuntimes")
      fi
    else
      STARTED_SERVER_CONTAINER=""
      STARTED_SERVER_RUNTIME=""
      if scenario_capability_contains "$(manifest_path "${peer}")" "${scenario}" "directions" \
          "peer-server-to-local-client"; then
        if start_server_role "${peer}" "${scenario}" && wait_for_peer_health "${peer}" "${scenario}"; then
          if scenario_capability_contains "$(manifest_path "${peer}")" "${scenario}" "localRuntimes" "jvm"; then
            local_lane_report "${scenario}" "jvm" "client" "${peer}" "peer-server-to-local-client" \
              || failures=$((failures + 1))
          fi
          if scenario_capability_contains "$(manifest_path "${peer}")" "${scenario}" "localRuntimes" "native"; then
            local_lane_report "${scenario}" "native" "client" "${peer}" "peer-server-to-local-client" \
              || failures=$((failures + 1))
          fi
        else
          failures=$((failures + 1))
        fi
      fi
      cleanup_started_server

      if scenario_capability_contains "$(manifest_path "${peer}")" "${scenario}" "directions" \
          "local-server-to-peer-client"; then
        while IFS= read -r runtime; do
          STARTED_LOCAL_SERVER_PID=""
          if start_local_server_lane "${scenario}" "${runtime}" "${peer}"; then
            run_container_role "${peer}" "client" "${scenario}" "${runtime}-server-to-peer-client" \
              "" "$(local_runtime_name "${runtime}")" \
              || failures=$((failures + 1))
          else
            failures=$((failures + 1))
          fi
          cleanup_started_local_server
        done < <(scenario_capability_values "$(manifest_path "${peer}")" "${scenario}" "localRuntimes")
      fi
    fi
  done

  if [[ "${require_live}" == "true" && "${failures}" -gt 0 ]]; then
    return 1
  fi
}

main() {
  local command="${1:-help}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "${command}" in
    help|-h|--help) usage ;;
    validate-manifests) validate_manifests ;;
    validate-gates) validate_gates "$@" ;;
    prepare-cache) prepare_cache "$@" ;;
    build-image) build_image "$@" ;;
    launch) launch_peer "$@" ;;
    health) health_peer "$@" ;;
    report) report_peer "$@" ;;
    run-scenario) run_scenario "$@" ;;
    run-direction-matrix) run_direction_matrix "$@" ;;
    local-lane-report) local_lane_report "$@" ;;
    native-lane-report) native_lane_report "$@" ;;
    *) fail "unknown command '${command}'" ;;
  esac
}

main "$@"
