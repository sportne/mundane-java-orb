#pragma prefix "example.com"

module Wide {
  typedef sequence<string, 4> Names;

  enum Color {
    RED,
    GREEN,
    BLUE
  };

  struct Point {
    long x;
    long y;
    Names labels;
  };

  union Choice switch (long) {
    case 0:
      long number;
    case 1:
      string text;
    default:
      Point point;
  };

  exception Problem {
    string reason;
  };

  interface Service {
    readonly attribute Names aliases;
    void submit(in Point point, out Choice result, inout Names names)
      raises (Problem)
      context ("tenant", "trace");
  };
};
